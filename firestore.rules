rules_version = '2';

// ─────────────────────────────────────────────────────────────────────────
// Firestore security rules — reference copy, kept in the repo so the rules
// are versioned alongside the code. This file does NOT auto-deploy: paste
// the contents into the Firebase console (Firestore Database → Rules →
// Publish), or deploy with the Firebase CLI.
//
// ┌───────────────────────────────────────────────────────────────────────┐
// │  THESE ARE THE PHASE-2 RULES. DO NOT PUBLISH THEM UNTIL EVERY DEVICE  │
// │  SHOWS "Signed in as …" IN ITS SETTINGS (see AUTH-SETUP.md).          │
// │  Until then the live rules stay `allow read, write: if true`, which   │
// │  keeps every existing iPad working while sign-in is rolled out.       │
// └───────────────────────────────────────────────────────────────────────┘
//
// SECURITY MODEL (from phase 2): a signed-in Firebase Auth user is required
// for everything; accounts are created only in the console (self sign-up is
// off). Destructive actions additionally need a manager account — an email
// in the list below. App Check (reCAPTCHA v3, enforced; see APPCHECK_SITE_KEY
// in js/firebase-sync.js) stays on as the anti-bot layer: Auth says WHO the
// request is from, App Check says it came from THIS app.
// ─────────────────────────────────────────────────────────────────────────

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }

    // Manager accounts — fill in the real addresses before publishing.
    function isManager() {
      return signedIn() && request.auth.token.email in [
        'design@stellamarine.com.au'
      ];
    }

    // Material + consumables orders. Deleting an order record (single or
    // "delete all") is manager-only; everything else any signed-in device
    // does — workers submit, the warehouse confirms deliveries.
    match /orders/{orderId} {
      allow read, create, update: if signedIn();
      allow delete: if isManager();
    }

    // Consumables stock levels + barcodes (checkout on the door iPad,
    // intake on the warehouse iPad, adjustments on the manager page).
    match /stock/{itemId} {
      allow read, write: if signedIn();
    }

    // Consumables stock history — append-only from the app's point of view;
    // reverting is an update, and permanently deleting a record is manager-only.
    match /stock_history/{recordId} {
      allow read, create, update: if signedIn();
      allow delete: if isManager();
    }

    // Materials stock levels (stocktake counts) and stocktake sessions.
    match /material_stock/{id} {
      allow read, write: if signedIn();
    }
    match /material_stocktakes/{id} {
      allow read, write: if signedIn();
    }

    // App version marker, connection probe, and the consumables SC-code counter.
    match /meta/{docId} {
      allow read, write: if signedIn();
    }

    // Block everything else
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
