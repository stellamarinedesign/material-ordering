rules_version = '2';

// Firestore security rules for the material ordering app — the canonical
// copy, deployed from this repo with the Firebase CLI:
//
//     firebase deploy --only firestore:rules
//
// (firebase.json and .firebaserc point it at this file and the project; add
// --project <id> for the test project.) No addresses live here: who is what
// is the settings/access document, which these rules read. Same model as the
// production board.
//
// THE MODEL. An account counts only if a master listed it. Every read needs a
// LISTED account — a manager, an engineer or a floor address in
// settings/access — so a Firebase user that nobody listed reads nothing,
// which is what makes it safe for the app to create users (sign-up on in the
// console). In this app floor is the kiosk iPads and anyone ordering, and
// they write what the workshop writes: orders, deliveries, stock and
// stocktake counts. Permanent deletes, the materials catalogue and the
// accounts themselves need a manager. The access document is written only by
// a master, except the first time, when nothing exists yet and whoever is
// setting up claims it.
//
// App Check (reCAPTCHA v3, enforced; see APPCHECK_SITE_KEY in
// js/firebase-sync.js) stays on as the anti-bot layer: Auth says WHO the
// request is from, App Check says it came from THIS app.

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }

    // The one document that says who is what. Read once per request by the
    // rules themselves (a get() costs one document read, cached within the
    // request). Missing, it fails closed: nobody is anything.
    function accessExists() {
      return exists(/databases/$(database)/documents/settings/access);
    }
    function access() {
      return get(/databases/$(database)/documents/settings/access).data;
    }
    function email() { return request.auth.token.email.lower(); }
    function onList(name) { return email() in access().get(name, []); }

    function manager()  { return signedIn() && onList('managers'); }
    function engineer() { return signedIn() && onList('engineers'); }
    function listed()   { return signedIn() && (onList('managers') || onList('engineers') || onList('floor')); }

    // MASTERS are not a role: a master is whatever role they are, and the
    // only one who may change the lists. With no masters list, or an empty
    // one, the first manager listed is the master - so the document can be
    // claimed and then handed on from inside the app.
    function masters() {
      let m = access().get('masters', []);
      return m.size() > 0 ? m : [access().managers[0]];
    }
    function master() { return signedIn() && email() in masters(); }

    // Material + consumables orders. Deleting an order record (single or
    // "delete all") is manager-only; everything else any listed device does
    // — workers submit, the warehouse confirms deliveries.
    match /orders/{orderId} {
      allow read, create, update: if listed();
      allow delete: if manager();
    }

    // Consumables stock levels + barcodes (checkout on the door iPad,
    // intake on the warehouse iPad, adjustments on the manager page).
    match /stock/{itemId} {
      allow read, write: if listed();
    }

    // Consumables stock history — append-only from the app's point of view;
    // reverting is an update, and permanently deleting a record is manager-only.
    match /stock_history/{recordId} {
      allow read, create, update: if listed();
      allow delete: if manager();
    }

    // Materials stock levels (stocktake counts) and stocktake sessions.
    match /material_stock/{id} {
      allow read, write: if listed();
    }
    match /material_stocktakes/{id} {
      allow read, write: if listed();
    }

    // App version marker, connection probe, the consumables SC-code counter —
    // and the materials catalogue (documents whose id starts with "catalog":
    // catalogMaterials, catalogMaterialsPrevious, catalogErpParts), which
    // every device reads but only a manager may change.
    match /meta/{docId} {
      allow read: if listed();
      allow write: if listed() && (!docId.matches('catalog.*') || manager());
    }

    // The accounts and their roles. Read by anyone listed; written by a
    // master, or by anyone signed in the first time, when it does not exist.
    match /settings/access {
      allow read:  if listed();
      allow write: if master() || !accessExists();
    }

    // Who changed the accounts: one document per change, append-only.
    match /activity/{entryId} {
      allow read:   if listed();
      allow create: if manager();
      allow update, delete: if false;
    }

    // Everything else is closed.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
