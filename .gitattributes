# Text files are stored LF in the repo AND checked out LF on every machine
# (eol=lf overrides Windows autocrlf), so editors and tools stop tripping the
# "LF will be replaced by CRLF" warnings. Excel still writes CRLF when it saves
# a CSV — Git quietly normalises that back to LF on the next commit.
* text=auto eol=lf

# Never touch these
*.png   binary
*.jpg   binary
*.jpeg  binary
*.ico   binary
*.pdf   binary
*.xlsx  binary
*.woff  binary
*.woff2 binary
*.ttf   binary
